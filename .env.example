# Copy to .env and fill in. Never commit .env.

# --- LLM (Groq free tier: https://console.groq.com) ---
# API key used by the generation pipeline (web app and batch command).
GROQ_API_KEY=
# Main model for generation. Pick one available on your Groq free tier.
GROQ_MODEL=
# Smaller fallback model used when the main one is rate limited.
GROQ_FALLBACK_MODEL=
# Max tokens per minute your free tier allows; the limiter stays under this.
LLM_TOKENS_PER_MINUTE=6000

# --- Retrieval ---
# Set to true ONLY for local/batch runs against localhost fixture sites.
# Must be false in production so private and loopback addresses are rejected.
ALLOW_PRIVATE_HOSTS=false
# User agent sent when fetching company sites.
CRAWLER_USER_AGENT=PrepKitBot/0.1 (interview prep assessment)

# --- API server (used from Day 2) ---
# MongoDB Atlas connection string.
MONGODB_URI=
# Secret used to sign session JWTs. Use a long random string.
JWT_SECRET=
# Port the Express API listens on.
PORT=4000
# Public URL of the web app, used for CORS.
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
